{
  "name": "Hawkeye ROS 2 Humble",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.override.yml"
  ],
  "service": "ros2_workspace",
  "workspaceFolder": "/ros2_ws",
  "overrideCommand": true,
  "remoteUser": "ros",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-python.pylance",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.autoComplete.extraPaths": [
          "/opt/ros/humble/local/lib/python3.10/dist-packages",
          "/opt/ros/humble/lib/python3.10/site-packages",
          "/ros2_ws/install/hawkeye_msgs/local/lib/python3.10/dist-packages",
          "/ros2_ws/install/imaging_realsense/lib/python3.10/site-packages",
          "/ros2_ws/install/orchestrator/lib/python3.10/site-packages",
          "/ros2_ws/install/streaming/lib/python3.10/site-packages"
        ],
        "python.analysis.extraPaths": [
          "/opt/ros/humble/local/lib/python3.10/dist-packages",
          "/opt/ros/humble/lib/python3.10/site-packages",
          "/ros2_ws/install/hawkeye_msgs/local/lib/python3.10/dist-packages",
          "/ros2_ws/install/imaging_realsense/lib/python3.10/site-packages",
          "/ros2_ws/install/orchestrator/lib/python3.10/site-packages",
          "/ros2_ws/install/streaming/lib/python3.10/site-packages"
        ],
        "C_Cpp.default.includePath": [
          "/opt/ros/humble/include/**",
          "/ros2_ws/install/include/**"
        ],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [],
  "runServices": [
    "ros2_workspace"
  ]
}